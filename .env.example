# AURA v3.5 — LLM Provider Configuration
# Copy this file to .env and fill in your values.
# WARNING: .env contains secrets — NEVER commit it to git.
# .env is already in .gitignore.

# ── LLM Provider (OpenAI-compatible API) ────────────────────────────────────
# Required for autonomous remediation (aura auto-fix).
# Static audit (aura audit) does NOT require LLM credentials.
AURA_LLM_URL=url-your-key-here
AURA_LLM_KEY=sk-your-api-key-here
AURA_LLM_MODEL=model-your-key-hereo

# ── Optional: Database path ─────────────────────────────────────────────────
# Default: .aura/state/aura.db (project-local, gitignored)
# AURA_DB_PATH=.aura/state/aura.db

# ── Optional: Log level ─────────────────────────────────────────────────────
# Default: WARNING (choices: DEBUG, INFO, WARNING, ERROR)
# AURA_LOG_LEVEL=WARNING

# ── Optional: AURA config path override ─────────────────────────────────────
# Default: config/aura.json then aura.json
# AURA_CONFIG_PATH=config/aura.json