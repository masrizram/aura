# ============================================================
# AURA Audit Engine — LLM Provider Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your setup.
#
# The engine auto-detects the provider in this order:
#   1. AURA_LLM_PROVIDER (explicit override)
#   2. OPENAI_API_KEY
#   3. ANTHROPIC_API_KEY
#   4. OPENROUTER_API_KEY
#   5. OLLAMA_HOST (default: http://localhost:11434)
# ============================================================

# Explicit provider override (openai | anthropic | ollama | openrouter)
AURA_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Ollama (local models)
OLLAMA_HOST=http://localhost:11434

# Repository root override (set automatically by the engine)
# AURA_REPO_ROOT=/path/to/aura

# ============================================================
# Notifications
# ============================================================
AURA_SLACK_WEBHOOK_URL=
AURA_SLACK_CHANNEL=#aura-audit
AURA_DISCORD_WEBHOOK_URL=
AURA_SMTP_HOST=localhost
AURA_SMTP_PORT=587
AURA_EMAIL_FROM=aura@localhost
AURA_EMAIL_TO=
AURA_WEBHOOK_URL=