# ============================================================
# AURA v3.5 — .gitignore
# ============================================================

# ── Secrets / Credentials — NEVER COMMIT ─────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json

# ── AURA Runtime State (local per-project DB + artifacts) ────
.aura/state/
.aura/evidence/
.aura/checkpoint.json
.aura/cycle-*.patch
.aura/agents/
.aura/docs/
.aura/modules/
.aura/plugins/
.aura/reports/
.aura/lang/
.aura/*.json
.aura/*.ps1

# ── AURA Benchmark Artifacts ─────────────────────────────────
aura_benchmark/
aura_benchmark_v3/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so
*.pyd

# ── Virtual Environments ─────────────────────────────────────
.venv/
.venv-*/
venv/
env/
.python-version

# ── Cache ────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Temp / Scratch ───────────────────────────────────────────
*.tmp
*.tmp.*
/tmp/

# ── CI / CD (project-local, not needed in repo) ──────────────
.circleci/
.githooks/
.github/workflows/aura-*.yml
.github/workflows/plugin-registry.yml
.github/homebrew/

# ── Git metadata ─────────────────────────────────────────────
.gitattributes
# ── Tools directory ──────────────────────────────────────────────
tools/
