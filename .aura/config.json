{
  "modules": {
    "required": [
      "business-invariants.ps1",
      "evidence-integrity.ps1",
      "independent-verifier.ps1",
      "security-scan.ps1",
      "git-safety.ps1"
    ],
    "optional": [
      "repo-graph.ps1",
      "sandbox.ps1",
      "capability-scoring.ps1",
      "scale-benchmark.ps1",
      "mutation-testing.ps1",
      "failure-recovery.ps1"
    ],
    "experimental": [
      "git-safety-adversarial.ps1",
      "false-evidence-attacks.ps1",
      "adversarial-campaign.ps1",
      "false-convergence-extended.ps1"
    ]
  },
  "engine": {
    "name": "Continuous Autonomous Engineering Audit Engine",
    "version": "2.1.0",
    "default_language": "en",
    "languages": {
      "en": "English",
      "id": "Bahasa Indonesia"
    },
    "max_cycles": 25,
    "max_cycles_without_progress": 3,
    "min_independent_cycles_for_convergence": 3,
    "consecutive_converged_cycles_required": 2,
    "state_machine": {
      "enabled": true,
      "enforce_finding_transitions": true,
      "enforce_gate_transitions": true,
      "enforce_classification_transitions": true,
      "max_score_increase_per_cycle": 15,
      "require_evidence_for_gate_flip": true,
      "max_consecutive_counter_increase": 1,
      "forbidden_direct_transitions": [
        {"from": "OPEN", "to": "VERIFIED", "reason": "Must pass through FIXED and VERIFYING"},
        {"from": "OPEN", "to": "FIXED", "reason": "Must pass through IN_PROGRESS"},
        {"from": "IN_PROGRESS", "to": "VERIFIED", "reason": "Must pass through FIXED and VERIFYING"},
        {"from": "FIXED", "to": "VERIFIED", "reason": "Must pass through VERIFYING"}
      ]
    },
    "scale": {
      "warn_file_count": 500,
      "require_chunked_audit_above": 2000,
      "require_prioritized_audit_above": 5000,
      "track_audited_file_count": true
    },
    "tooling": {
      "execute_before_verification": true,
      "capture_exit_codes": true,
      "auto_detect_commands": true,
      "required_pass_commands": []
    },
    "scope": {
      "validate_audit_scope": true,
      "min_audit_pct_for_convergence": 80,
      "warn_below_pct": 50
    },
    "audit": {
      "enforce_full_audit_every_cycle": true,
      "require_fresh_adversarial_review_every_cycle": true,
      "require_independent_discovery_every_cycle": true,
      "zero_open_findings_does_not_prove_zero_undiscovered": true
    },
    "convergence_gate": {
      "P0": 0,
      "P1": 0,
      "P2": 0,
      "require": [
        "Critical Security = PASS",
        "Critical Correctness = PASS",
        "Data Integrity = PASS",
        "Regression = PASS",
        "Verification = PASS",
        "No Material New Findings = PASS",
        "Remaining Limitations Documented = PASS",
        "Consecutive Clean Independent Audits = PASS",
        "Module Dependency Integrity = PASS"
      ],
      "require_all_required_modules_loaded": true,
      "allow_experimental_missing": true,
      "allow_optional_missing": true
    }
  },
  "severity": {
    "P0": { "label": "Catastrophic / Immediate Blocker", "weight": 625 },
    "P1": { "label": "Critical", "weight": 405 },
    "P2": { "label": "High", "weight": 216 },
    "P3": { "label": "Medium", "weight": 90 },
    "P4": { "label": "Low", "weight": 30 },
    "P5": { "label": "Optimization / Polish", "weight": 6 }
  },
  "dimensions": {
    "Architecture": 0.14,
    "Correctness": 0.16,
    "Security": 0.18,
    "Reliability": 0.12,
    "Performance": 0.08,
    "Testing": 0.12,
    "Observability": 0.06,
    "Operations": 0.06,
    "Maintainability": 0.04,
    "Documentation": 0.04
  },
  "phases": [
    "DISCOVER",
    "MODEL",
    "AUDIT",
    "ADVERSARIAL_AUDIT",
    "CORRELATE",
    "PRIORITIZE",
    "REMEDIATE",
    "TEST",
    "VERIFY",
    "REGRESSION",
    "UPDATE_STATE",
    "CONVERGENCE",
    "PUSH_APPROVAL"
  ],
  "push": {
    "enabled": true,
    "auto_approve": false,
    "commit_template": "audit: cycle {cycle} automated remediation ({summary})",
    "require_clean_tree": false,
    "verify_remote_sha_after_push": true,
    "max_push_retries": 3
  },
  "state_files": {
    "cycle": "state/cycle.json",
    "findings": "state/findings.json",
    "convergence": "state/convergence.json"
  },
  "reports": {
    "audit_ledger": "reports/audit-ledger.md",
    "architecture_map": "reports/architecture-map.md",
    "risk_register": "reports/risk-register.md",
    "verification_matrix": "reports/verification-matrix.md",
    "remediation_log": "reports/remediation-log.md"
  },
  "prompts": {
    "master": "docs/master.md",
    "cycle": "docs/cycle.md",
    "adversarial": "docs/adversarial.md"
  },
  "locale": {
    "path": "lang",
    "files": {
      "en": "lang/en.json",
      "id": "lang/id.json"
    }
  },
  "language": "en",
  "convergence": {
    "consecutive_converged_cycles_required": 2,
    "min_independent_cycles_for_convergence": 3
  },
  "agents": {
    "independent_auditor": "src/agents/independent-auditor.md",
    "adversarial_auditor": "src/agents/adversarial-auditor.md",
    "remediator": "src/agents/remediator.md",
    "verifier": "src/agents/verifier.md",
    "regression_auditor": "src/agents/regression-auditor.md",
    "convergence_judge": "src/agents/convergence-judge.md"
  }
}