#!/usr/bin/env bash
# Auto-generate 5W commit message template with AURA state context
# Conventional commit types: feat, fix, docs, style, refactor, perf, test, chore, ci

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"
SHA1="$3"

if [ "$COMMIT_SOURCE" = "template" ] || [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ] || [ "$COMMIT_SOURCE" = "message" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
    exit 0
fi

BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
FILES=$(git diff --cached --name-only 2>/dev/null | head -5 || echo "")
CHANGED_COUNT=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ' || echo "0")

PYTHON_CMD=""
for cmd in python3 python; do
    if command -v "$cmd" &>/dev/null; then
        PYTHON_CMD="$cmd"
        break
    fi
done

AURA_CONTEXT=""
if [ -f ".aura/state/convergence.json" ] || [ -f ".aura/state/findings.json" ]; then
    AURA_CONTEXT="# --- AURA State ---"
    if [ -f ".aura/state/convergence.json" ] && [ -n "$PYTHON_CMD" ]; then
        CONV_STATUS=$("$PYTHON_CMD" -c "
import json
try:
    with open('.aura/state/convergence.json','r') as f:
        c = json.load(f)
    status = 'CONVERGED' if c.get('converged') else 'NOT CONVERGED'
    score = c.get('overall_score', 0)
    cycle = c.get('cycle', 0)
    print(f'Convergence: {status} | Score: {score} | Cycle: {cycle}')
except: print('Convergence: UNAVAILABLE')
" 2>/dev/null || echo "Convergence: UNAVAILABLE")
        AURA_CONTEXT="${AURA_CONTEXT}\n#   ${CONV_STATUS}"
    fi
    if [ -f ".aura/state/findings.json" ] && [ -n "$PYTHON_CMD" ]; then
        FINDINGS_SUMMARY=$("$PYTHON_CMD" -c "
import json
try:
    with open('.aura/state/findings.json','r') as f:
        data = json.load(f)
    arr = data if isinstance(data, list) else data.get('findings', [])
    open_f = [f for f in arr if f.get('status') in ('OPEN', 'IN_PROGRESS')]
    p0 = sum(1 for f in open_f if f.get('severity') == 'P0')
    p1 = sum(1 for f in open_f if f.get('severity') == 'P1')
    p2 = sum(1 for f in open_f if f.get('severity') == 'P2')
    print(f'Open findings: {len(open_f)} (P0:{p0} P1:{p1} P2:{p2})')
except: print('Findings: UNAVAILABLE')
" 2>/dev/null || echo "Findings: UNAVAILABLE")
        AURA_CONTEXT="${AURA_CONTEXT}\n#   ${FINDINGS_SUMMARY}"
    fi
fi

cat > "$COMMIT_MSG_FILE" <<TEMPLATE
# <type>: <short description>

# --- Conventional ---
# feat|fix|docs|style|refactor|perf|test|chore|ci

# --- 5W: pick ONE (use English) ---
# What:  <what changed>
# Who:   <who is involved>
# Where: <file/module/component>
# When:  <when>
# Why:   <reason>

# --- Context ---
# Branch: $BRANCH
# Files changed ($CHANGED_COUNT):
$(echo "$FILES" | sed 's/^/#   /')
# ---
$(echo -e "$AURA_CONTEXT")
TEMPLATE